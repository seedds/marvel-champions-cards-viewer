# Card art is regenerated by tools/build_assets.py, not committed.
# A fresh clone has card data and no art until that script has been run.
assets/CardImages/

# Everything under .cache/ is a pipeline cache or a report, and all of it is
# regenerable. It is not build/, which belongs to Flutter and which `flutter clean`
# deletes -- the 9.2 GB sheet cache would go with it.
.cache/

# The build script's bytecode, regenerated on every run.
__pycache__/
*.pyc

# Flutter
build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.DS_Store
